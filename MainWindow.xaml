<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="TextureMaker.MainWindow"
        Title="MainWindow" Height="513" Width="775" Background="#FF909090">
    <TabControl Margin="0,0,0,-6" Background="#FF5F5F5F">
        <TabItem x:Name="Atlas_Maker" Header="Atlas Make">
            <TabItem.Background>
                <LinearGradientBrush EndPoint="0,1">
                    <GradientStop Color="#FFF0F0F0"/>
                    <GradientStop Color="#FF5F5F5F" Offset="1"/>
                </LinearGradientBrush>
            </TabItem.Background>
            <Grid Background="#FF424242">
                <Button Content="Set Images" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10" Click="SetImages" Height="42" Width="218"/>
                <Button Content="Build Atlas" HorizontalAlignment="Left" Margin="10,0,0,61" Click="BuildAtlas" Width="218" Height="46" VerticalAlignment="Bottom"/>
                <StackPanel Margin="10,10,0,0" Background="#FF5F5F5F" Height="177" VerticalAlignment="Top" HorizontalAlignment="Left" Width="220" >
                    <StackPanel Orientation="Horizontal" Height="76" Width="186" Background="#FF909090" >
                        <TextBox x:Name="img_width" TextWrapping="Wrap" Text="Image width" Height="30" Width="90"/>
                        <TextBox x:Name="img_height" TextWrapping="Wrap" Text="Image height" Height="30" Width="94" Margin="1,0,0,0" />
                    </StackPanel>
                    <Button Content="Set Image Size" Click="Button_Click" Height="56" Width="206" Margin="5,5,5,0"/>
                </StackPanel>
                <Grid x:Name="ImageArray" Margin="310,10,10,10" Background="#FF5F5F5F"/>
            </Grid>
        </TabItem>
        <TabItem x:Name="RGB_Comb" Header="RGB Combine" Height="22" Margin="-2,0,-2,0" VerticalAlignment="Bottom">
            <Grid Background="#FF424242">
                <StackPanel x:Name="R" Margin="0,35,0,0" HorizontalAlignment="Left" Width="120" Height="163" VerticalAlignment="Top">
                    <Image x:Name="Red" Height="100" Width="100" Source="/eb07b1f8cf311f0aaca16d0d2272db5_1.jpeg"/>
                    <Label Content="Red&#xD;&#xA;" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#00000000" Foreground="White"/>
                    <Button Content="Select" Margin="0,7,0,0"/>
                </StackPanel>
                <StackPanel x:Name="G" Margin="212,35,0,0" Height="163" VerticalAlignment="Top" HorizontalAlignment="Left" Width="120">
                    <Image x:Name="Green" Height="100" Width="100" OpacityMask="Black" Source="/eb07b1f8cf311f0aaca16d0d2272db5_1.jpeg"/>
                    <Label Content="Green&#xD;&#xA;" HorizontalAlignment="Center" Background="#00000000" Foreground="White" Height="30"/>
                    <Button Content="Select" Margin="0,7,0,0"/>
                </StackPanel>
                <StackPanel x:Name="B" Margin="0,0,0,28" Height="165" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="120">
                    <Image x:Name="Blue" Height="100" Width="100" OpacityMask="Black" Source="/eb07b1f8cf311f0aaca16d0d2272db5_1.jpeg"/>
                    <Label Content="Blue" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#00000000" Foreground="White"/>
                    <Button Content="Select" Margin="0,7,0,0"/>
                </StackPanel>
                <StackPanel x:Name="A" Margin="212,0,0,28" Height="165" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="120">
                    <Image x:Name="Alpha" Height="100" Width="100" OpacityMask="Black" Source="/eb07b1f8cf311f0aaca16d0d2272db5_1.jpeg"/>
                    <Label Content="Alpha" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#00000000" Foreground="White"/>
                    <Button Content="Select" Margin="0,7,0,0"/>
                </StackPanel>
                <StackPanel x:Name="Out" Margin="0,0,0,10" HorizontalAlignment="Right" Width="331">
                    <Image x:Name="Result" Height="309" Width="309" OpacityMask="Black" Source="/eb07b1f8cf311f0aaca16d0d2272db5_1.jpeg"/>
                    <Label Content="Output" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#00000000" Foreground="White"/>
                    <Button Content="Save" Height="57" Margin="0,11,0,0"/>
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
