<Window x:Class="TextureMaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="450" Width="800" ResizeMode="NoResize">
    <Grid Background="#FF929292">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="234"/>
            <ColumnDefinition Width="305"/>
            <ColumnDefinition Width="261"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="ItemViewer" RenderTransformOrigin="0.5,0.5" Margin="12,0,0,0" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                            <SkewTransform CenterX="0.5" CenterY="0.5"/>
                            <RotateTransform Angle="-90" CenterX="0.5" CenterY="0.5"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FF929292"/>
                    <GradientStop Color="White" Offset="0.5"/>
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>
        <Button Content="Set Images" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,341,0,0" Click="SetImages" Height="42" Width="218"/>
        <Button Content="Build Atlas" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,290,0,0" Click="BuildAtlas" Height="46" Width="218"/>

        <StackPanel Margin="13,15,1,242" Background="Black" >
            <StackPanel Orientation="Horizontal" Height="76" Width="186" Background="#FF3A3A3A" >
                <TextBox x:Name="img_width" TextWrapping="Wrap" Text="Image width" Height="30" Width="90"/>
                <TextBox x:Name="img_height" TextWrapping="Wrap" Text="Image height" Height="30" Width="94" Margin="1,0,0,0" />
            </StackPanel>
            <Button Content="Set Image Size" Click="Button_Click" Height="56" Width="206" Margin="5,5,5,0"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Left" Height="142" Margin="0,143,0,0" VerticalAlignment="Top" Width="218" Background="Black" Visibility="Hidden">
            <StackPanel Height="77" Orientation="Horizontal" Background="#FF3A3A3A" Width="182" Visibility="Hidden">
                <TextBox x:Name="atlas_height" TextWrapping="Wrap" Text="Atlas height" Height="30" Width="90" Visibility="Hidden"/>
                <TextBox x:Name="atlas_width" TextWrapping="Wrap" Text="Atlas width" Height="30" Width="90" Margin="1,0,0,0" Visibility="Hidden" />
            </StackPanel>
            <Button Content="Set Atlas Size" Click="Button_Click_1" Height="52" Width="218" Margin="5,5,5,0" Visibility="Hidden" />
        </StackPanel>
    </Grid>
</Window>
